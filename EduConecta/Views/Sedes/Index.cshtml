@model EduConecta.Helpers.ListaPaginada<EduConecta.Models.Sede>

@{
    ViewData["Title"] = "Sedes";
}

<h1>Sedes</h1>

<form asp-action="Index" method="get" class="row g-2 align-items-end mb-3">
    <div class="col-md-5">
        <label class="form-label" for="busqueda">Buscar por campus, ciudad o pais</label>
        <input type="text" id="busqueda" name="busqueda" class="form-control"
               value="@ViewData["Busqueda"]" />
    </div>

    <div class="col-md-3">
        @await Html.PartialAsync("_TamanoPagina", Model.TamanoPagina)
    </div>

    <div class="col-md-4 d-flex gap-2">
        <button type="submit" class="btn btn-primary">Buscar</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
        <a asp-action="Create" class="btn btn-success">Nueva sede</a>
    </div>
</form>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Campus</th>
            <th>Ciudad</th>
            <th>Pais</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var sede in Model)
        {
            <tr>
                <td>@sede.NombreCampus</td>
                <td>@sede.Ciudad</td>
                <td>@sede.Pais</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@sede.Id">Editar</a> |
                    <a asp-action="Details" asp-route-id="@sede.Id">Detalles</a> |
                    <a asp-action="Delete" asp-route-id="@sede.Id">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.Any())
{
    <div class="alert alert-info">No hay sedes que coincidan con la busqueda.</div>
}

@await Html.PartialAsync("_Paginacion", (EduConecta.Helpers.IListaPaginada)Model)
