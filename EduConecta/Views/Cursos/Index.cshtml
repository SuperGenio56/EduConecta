@model EduConecta.Helpers.ListaPaginada<EduConecta.Models.Curso>

@{
    ViewData["Title"] = "Cursos";
}

<h1>Cursos</h1>

<form asp-action="Index" method="get" class="row g-2 align-items-end mb-3">
    <div class="col-md-4">
        <label class="form-label" for="busqueda">Buscar por codigo o nombre</label>
        <input type="text" id="busqueda" name="busqueda" class="form-control"
               value="@ViewData["Busqueda"]" />
    </div>

    <div class="col-md-3">
        <label class="form-label" for="modalidad">Modalidad</label>
        <select id="modalidad" name="modalidad" class="form-select"
                asp-items="@(ViewData["Modalidad"] as SelectList)">
            <option value="">Todas las modalidades</option>
        </select>
    </div>

    <div class="col-md-2">
        @await Html.PartialAsync("_TamanoPagina", Model.TamanoPagina)
    </div>

    <div class="col-md-3 d-flex gap-2">
        <button type="submit" class="btn btn-primary">Buscar</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
        <a asp-action="Create" class="btn btn-success">Nuevo</a>
    </div>
</form>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Codigo</th>
            <th>Curso</th>
            <th>Creditos</th>
            <th>Modalidad</th>
            <th>Cupo</th>
            <th class="text-end">Costo (Bs)</th>
            <th>Docentes</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var curso in Model)
        {
            <tr>
                <td>@curso.CodigoCurso</td>
                <td>@curso.NombreCurso</td>
                <td>@curso.Creditos</td>
                <td>@curso.Modalidad</td>
                <td>@curso.CupoMaximo</td>
                <td class="text-end">@curso.CostoMatricula.ToString("N2")</td>
                <td>@string.Join(", ", curso.CursoDocentes.Select(cd => cd.Docente.NombreCompleto))</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@curso.Id">Editar</a> |
                    <a asp-action="Details" asp-route-id="@curso.Id">Detalles</a> |
                    <a asp-controller="Modulos" asp-action="Index" asp-route-cursoId="@curso.Id">Modulos</a> |
                    <a asp-action="Delete" asp-route-id="@curso.Id">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.Any())
{
    <div class="alert alert-info">No hay cursos que coincidan con la busqueda.</div>
}

@await Html.PartialAsync("_Paginacion", (EduConecta.Helpers.IListaPaginada)Model)
