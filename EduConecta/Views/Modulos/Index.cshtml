@model List<EduConecta.Models.Modulo>

@{
    ViewData["Title"] = "Modulos";
}

<h1>Modulos de @ViewData["Curso"]</h1>

<div class="d-flex gap-2 mb-3">
    <a asp-action="Create" asp-route-cursoId="@ViewData["CursoId"]" class="btn btn-success">Nuevo modulo</a>
    <a asp-controller="Cursos" asp-action="Index" class="btn btn-outline-secondary">Volver a cursos</a>
</div>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>N.</th>
            <th>Modulo</th>
            <th>Contenido</th>
            <th class="text-end">Horas</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var modulo in Model)
        {
            <tr>
                <td>@modulo.NumeroModulo</td>
                <td>@modulo.NombreModulo</td>
                <td>@modulo.Contenido</td>
                <td class="text-end">@modulo.HorasEstimadas</td>
                <td>
                    <a asp-action="Edit" asp-route-cursoId="@modulo.CursoId"
                       asp-route-numeroModulo="@modulo.NumeroModulo">Editar</a> |
                    <a asp-action="Delete" asp-route-cursoId="@modulo.CursoId"
                       asp-route-numeroModulo="@modulo.NumeroModulo">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
    @if (Model.Any())
    {
        <tfoot>
            <tr class="fw-bold">
                <td colspan="3">Total de horas</td>
                <td class="text-end">@Model.Sum(m => m.HorasEstimadas)</td>
                <td></td>
            </tr>
        </tfoot>
    }
</table>

@if (!Model.Any())
{
    <div class="alert alert-info">Este curso todavia no tiene modulos.</div>
}
