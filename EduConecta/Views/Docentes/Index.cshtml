@model EduConecta.Helpers.ListaPaginada<EduConecta.Models.Docente>

@{
    ViewData["Title"] = "Docentes";
}

<h1>Docentes</h1>

<form asp-action="Index" method="get" class="row g-2 align-items-end mb-3">
    <div class="col-md-5">
        <label class="form-label" for="busqueda">Buscar por nombre, especialidad o correo</label>
        <input type="text" id="busqueda" name="busqueda" class="form-control"
               value="@ViewData["Busqueda"]" />
    </div>

    <div class="col-md-3">
        @await Html.PartialAsync("_TamanoPagina", Model.TamanoPagina)
    </div>

    <div class="col-md-4 d-flex gap-2">
        <button type="submit" class="btn btn-primary">Buscar</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
        <a asp-action="Create" class="btn btn-success">Nuevo docente</a>
    </div>
</form>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Docente</th>
            <th>Especialidad</th>
            <th>Correo</th>
            <th>Cursos</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var docente in Model)
        {
            <tr>
                <td>@docente.NombreCompleto</td>
                <td>@docente.Especialidad</td>
                <td>@docente.Correo</td>
                <td>@docente.CursoDocentes.Count</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@docente.Id">Editar</a> |
                    <a asp-action="Details" asp-route-id="@docente.Id">Detalles</a> |
                    <a asp-action="Delete" asp-route-id="@docente.Id">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.Any())
{
    <div class="alert alert-info">No hay docentes que coincidan con la busqueda.</div>
}

@await Html.PartialAsync("_Paginacion", (EduConecta.Helpers.IListaPaginada)Model)
