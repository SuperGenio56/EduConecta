@model EduConecta.Helpers.ListaPaginada<EduConecta.Models.Beca>

@{
    ViewData["Title"] = "Becas";
}

<h1>Becas</h1>

<form asp-action="Index" method="get" class="row g-2 align-items-end mb-3">
    <div class="col-md-3">
        <label class="form-label" for="busqueda">Buscar por tipo de beca</label>
        <input type="text" id="busqueda" name="busqueda" class="form-control"
               value="@ViewData["Busqueda"]" />
    </div>

    <div class="col-md-4">
        <label class="form-label" for="estudianteId">Estudiante</label>
        <select id="estudianteId" name="estudianteId" class="form-select"
                asp-items="@(ViewData["EstudianteId"] as SelectList)">
            <option value="">Todos los estudiantes</option>
        </select>
    </div>

    <div class="col-md-2">
        @await Html.PartialAsync("_TamanoPagina", Model.TamanoPagina)
    </div>

    <div class="col-md-3 d-flex gap-2">
        <button type="submit" class="btn btn-primary">Buscar</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
        <a asp-action="Create" class="btn btn-success">Nueva</a>
    </div>
</form>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Estudiante</th>
            <th>Tipo de beca</th>
            <th class="text-end">Descuento</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var beca in Model)
        {
            <tr>
                <td>@beca.Estudiante.NombreCompleto</td>
                <td>@beca.TipoBeca</td>
                <td class="text-end">@beca.PorcentajeDescuento.ToString("N2") %</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@beca.Id">Editar</a> |
                    <a asp-action="Details" asp-route-id="@beca.Id">Detalles</a> |
                    <a asp-action="Delete" asp-route-id="@beca.Id">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.Any())
{
    <div class="alert alert-info">No hay becas que coincidan con la busqueda.</div>
}

@await Html.PartialAsync("_Paginacion", (EduConecta.Helpers.IListaPaginada)Model)
