@model EduConecta.Models.Beca

@{
    ViewData["Title"] = "Eliminar beca";
}

<h1 class="text-danger">Eliminar beca</h1>
<p>Esta seguro de eliminar esta beca?</p>

<dl class="row">
    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Estudiante)</dt>
    <dd class="col-sm-9">@Model.Estudiante.NombreCompleto</dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.TipoBeca)</dt>
    <dd class="col-sm-9">@Model.TipoBeca</dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.PorcentajeDescuento)</dt>
    <dd class="col-sm-9">@Model.PorcentajeDescuento.ToString("N2") %</dd>
</dl>

<form asp-action="Delete" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Eliminar</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
</form>
