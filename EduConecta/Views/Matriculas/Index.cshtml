@model EduConecta.Helpers.ListaPaginada<EduConecta.Models.Matricula>

@{
    ViewData["Title"] = "Matriculas";
}

<h1>Matriculas</h1>

<form asp-action="Index" method="get" class="row g-2 align-items-end mb-3">
    <div class="col-md-2">
        <label class="form-label" for="periodoAcademico">Periodo</label>
        <select id="periodoAcademico" name="periodoAcademico" class="form-select"
                asp-items="@(ViewData["PeriodoAcademico"] as SelectList)">
            <option value="">Todos</option>
        </select>
    </div>

    <div class="col-md-3">
        <label class="form-label" for="cursoId">Curso</label>
        <select id="cursoId" name="cursoId" class="form-select"
                asp-items="@(ViewData["CursoId"] as SelectList)">
            <option value="">Todos los cursos</option>
        </select>
    </div>

    <div class="col-md-2">
        <label class="form-label" for="estado">Estado</label>
        <select id="estado" name="estado" class="form-select"
                asp-items="@(ViewData["Estado"] as SelectList)">
            <option value="">Todos</option>
        </select>
    </div>

    <div class="col-md-2">
        @await Html.PartialAsync("_TamanoPagina", Model.TamanoPagina)
    </div>

    <div class="col-md-3 d-flex gap-2">
        <button type="submit" class="btn btn-primary">Buscar</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
        <a asp-action="Create" class="btn btn-success">Nueva</a>
    </div>
</form>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Estudiante</th>
            <th>Curso</th>
            <th>Periodo</th>
            <th>Fecha</th>
            <th>Estado</th>
            <th>Beca</th>
            <th class="text-end">Monto becado</th>
            <th class="text-end">Monto a pagar</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var matricula in Model)
        {
            <tr>
                <td>@matricula.Estudiante.NombreCompleto</td>
                <td>@matricula.Curso.NombreCurso</td>
                <td>@matricula.PeriodoAcademico</td>
                <td>@matricula.FechaMatricula.ToString("dd/MM/yyyy")</td>
                <td>@matricula.Estado</td>
                <td>@(matricula.Beca?.TipoBeca ?? "Sin beca")</td>
                <td class="text-end">@matricula.MontoBecado.ToString("N2")</td>
                <td class="text-end">@matricula.MontoAPagar.ToString("N2")</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@matricula.Id">Editar</a> |
                    <a asp-action="Details" asp-route-id="@matricula.Id">Detalles</a> |
                    <a asp-action="Delete" asp-route-id="@matricula.Id">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.Any())
{
    <div class="alert alert-info">No hay matriculas que coincidan con la busqueda.</div>
}

@await Html.PartialAsync("_Paginacion", (EduConecta.Helpers.IListaPaginada)Model)
