@model EduConecta.Helpers.ListaPaginada<EduConecta.Models.Estudiante>

@{
    ViewData["Title"] = "Estudiantes";
}

<h1>Estudiantes</h1>

<form asp-action="Index" method="get" class="row g-2 align-items-end mb-3">
    <div class="col-md-4">
        <label class="form-label" for="busqueda">Buscar por nombre o apellido</label>
        <input type="text" id="busqueda" name="busqueda" class="form-control"
               value="@ViewData["Busqueda"]" />
    </div>

    <div class="col-md-3">
        <label class="form-label" for="sedeId">Sede</label>
        <select id="sedeId" name="sedeId" class="form-select"
                asp-items="@(ViewData["SedeId"] as SelectList)">
            <option value="">Todas las sedes</option>
        </select>
    </div>

    <div class="col-md-2">
        @await Html.PartialAsync("_TamanoPagina", Model.TamanoPagina)
    </div>

    <div class="col-md-3 d-flex gap-2">
        <button type="submit" class="btn btn-primary">Buscar</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
        <a asp-action="Create" class="btn btn-success">Nuevo</a>
    </div>
</form>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Estudiante</th>
            <th>Edad</th>
            <th>Sede</th>
            <th>Direccion</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var estudiante in Model)
        {
            <tr>
                <td>@estudiante.NombreCompleto</td>
                <td>@estudiante.Edad</td>
                <td>@estudiante.Sede.NombreCampus</td>
                <td>@estudiante.DireccionCompleta</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@estudiante.Id">Editar</a> |
                    <a asp-action="Details" asp-route-id="@estudiante.Id">Detalles</a> |
                    <a asp-action="Delete" asp-route-id="@estudiante.Id">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.Any())
{
    <div class="alert alert-info">No hay estudiantes que coincidan con la busqueda.</div>
}

@await Html.PartialAsync("_Paginacion", (EduConecta.Helpers.IListaPaginada)Model)
